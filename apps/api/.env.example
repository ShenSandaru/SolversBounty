# Copy to apps/api/.env. Values below are local placeholders, not secrets.
# Authentication and treasury signing are not implemented.
# Session shape is ADR-003. Treasury key storage is ADR-006.
# Omit DATABASE_URL in development to start without PostgreSQL.
# Production requires DATABASE_URL. Do not put a real treasury key here.
# DATABASE_URL is the pooled Neon host (the hostname contains -pooler) and must include sslmode=require.
# DIRECT_URL is the direct Neon host for Prisma CLI migrations. The running API does not use it.

DATABASE_URL=
DIRECT_URL=
PORT=3001
SOLANA_RPC_URL=https://api.devnet.solana.com
CORS_ORIGIN=http://localhost:3000
JSON_BODY_LIMIT=64kb
AUTH_TOKEN_SECRET=
ANSWER_ENCRYPTION_KEY=
TREASURY_SECRET_KEY=
# Public treasury address. This is not a secret. Funding is refused until it is set. Devnet only.
TREASURY_PUBLIC_KEY=
# false reconciles stored payout signatures and does not sign or broadcast new transfers.
PAYOUT_BROADCAST_ENABLED=false
ADMIN_WALLET_ALLOWLIST=
