# SolversBounty environment template.
# Copy the API block to apps/api/.env and the web block to apps/web/.env.local.
# Do not put real secrets in this file or commit a filled-in .env.

# --- API (apps/api) ---
# Optional in development and test. Required when NODE_ENV=production.
# Omit DATABASE_URL to serve /health without PostgreSQL.
# A URL that is set and cannot connect leaves /health up and /health/ready not ready.
# DATABASE_URL: pooled Neon connection for the API. Hostname contains -pooler. Include sslmode=require.
# DIRECT_URL: direct Neon connection for Prisma CLI. Same database, hostname without -pooler. Include sslmode=require.
DATABASE_URL=
DIRECT_URL=
PORT=3001
SOLANA_RPC_URL=https://api.devnet.solana.com
CORS_ORIGIN=http://localhost:3000
JSON_BODY_LIMIT=64kb

# Placeholders only. Treasury signing is not implemented.
# Wallet login is implemented. The session lifetime is an 8-hour working default, not an accepted ADR decision.
# Session shape is ADR-003. Treasury key storage is ADR-006. Do not put a real treasury key here.
AUTH_TOKEN_SECRET=
ANSWER_ENCRYPTION_KEY=
TREASURY_SECRET_KEY=
TREASURY_PUBLIC_KEY=
ADMIN_WALLET_ALLOWLIST=

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
# Optional. The wallet adapter uses Devnet when this is omitted. Login does not send a transaction.
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
