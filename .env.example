# SolversBounty environment template.
# Copy the API block to apps/api/.env and the web block to apps/web/.env.local.
# Do not put real secrets in this file or commit a filled-in .env.

# --- API (apps/api) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/solversbounty
PORT=3001
SOLANA_RPC_URL=https://api.devnet.solana.com

# Placeholders only. Authentication and treasury signing are not implemented.
# PD-03 (session shape) and PD-15 (treasury key handling) are still proposed.
AUTH_TOKEN_SECRET=
ANSWER_ENCRYPTION_KEY=
TREASURY_SECRET_KEY=
ADMIN_WALLET_ALLOWLIST=

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
